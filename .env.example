# Server-side only. Never exposed to the browser.
# Without it the app still works: every question falls back to the
# deterministic router and templated Hebrew answers, flagged as degraded.
ANTHROPIC_API_KEY=sk-ant-...

# Model per role. All default to claude-haiku-4-5.
# LLM_MODEL sets all three at once; a per-role var wins over it.
#
#   router        classification over 7 tools  — a small model is correct here
#   narrator      open-ended Hebrew prose      — the only user-visible tier
#   canonicalizer closed-set choice, once per upload
#
# A useful production shape is a cheap router with a better narrator:
#   LLM_ROUTER_MODEL=claude-haiku-4-5
#   LLM_NARRATOR_MODEL=claude-sonnet-5
#
# LLM_MODEL=
# LLM_ROUTER_MODEL=
# LLM_NARRATOR_MODEL=
# LLM_CANONICALIZER_MODEL=

# Per-call wall clock before the deterministic path takes over.
# LLM_ROUTER_TIMEOUT_MS=6000
# LLM_NARRATOR_TIMEOUT_MS=6000

# Spend ceiling on a public endpoint. /api/ask is open to anyone, and every
# uncached question costs ~$0.0047, so these bound what strangers can spend.
#
#   ASK_RATE_BURST / ASK_RATE_PER_MINUTE   per-IP token bucket. Over it is a
#                                          429 — an abuse guard, not a budget.
#   LLM_DAILY_QUESTION_BUDGET              model-routed questions per UTC day.
#                                          Over it is NOT an error: answers
#                                          come from the deterministic router
#                                          and the template narrator, for
#                                          nothing, flagged in the UI. 0 turns
#                                          the model off without a redeploy.
#
# The default 4000 is the README's conservative row — a 60% cache hit rate at
# 10,000 requests/day — which caps the bill near $18.65/day, per instance.
# ASK_RATE_BURST=12
# ASK_RATE_PER_MINUTE=20
# LLM_DAILY_QUESTION_BUDGET=4000

# Signs the session cookie. Any long random string: openssl rand -base64 32
AUTH_SECRET=

# Two seeded accounts. Generate hashes with:
#   npm run hash-password -- "<password>"
# The hash is colon-delimited (scrypt:salt:hash), not the conventional
# $-delimited form, because dotenv expands $NAME as a variable reference and
# would silently mangle it. See docs/AI_LOG.md #7.
ADMIN_EMAIL=admin@madlan.local
ADMIN_PASSWORD_HASH=
USER_EMAIL=user@madlan.local
USER_PASSWORD_HASH=
